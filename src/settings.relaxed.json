{
  "$comment": "ThieuNV Claude Code baseline — .claude/settings.json, RELAXED profile (installed by install.sh --profile relaxed; the default/strict variant is settings.json). For isolated systems with no real secrets only: project-local secret reads (.env, keys, certs, secrets/) are permitted, docker / DB CLIs / package installs run without prompts, and curl/wget drop from deny to ask. Machine credentials (~/.ssh, ~/.aws, ~/.kube, kubeconfig), destructive commands (rm -rf, DROP/TRUNCATE, docker volume rm, git push to main) and the .claude/* self-edit denies stay exactly as in strict — the hooks read profile=relaxed from .claude/avn-version and lift only their project-secret rules. tests/settings-profile-test.sh asserts this file differs from settings.json in exactly the documented ways. Verify rules after install with /permissions inside Claude Code.",

  "permissions": {

    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npm install -g:*)",

      "Read(**/kubeconfig)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",

      "Edit(**/.github/**)",
      "Edit(**/.mcp.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/verify-commands)",
      "Edit(.claude/avn-version)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(systemctl:*)"
    ],

    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run e2e:*)",
      "Bash(npm run typecheck:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(tsc --noEmit:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm run e2e:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright screenshot:*)",
      "Bash(npx playwright show-report:*)",
      "Bash(npx playwright --version)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(python --version)",
      "Bash(docker:*)",
      "Bash(docker compose:*)",
      "Bash(docker-compose:*)",
      "Bash(npm install:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(npx playwright install:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)"
    ]
  },

  "$comment-env": "CLAUDE_AFK_TIMEOUT_MS disables the 60s AskUserQuestion auto-advance ('AFK mode') introduced unannounced in Claude Code v2.1.198, which made interview flows (/brainstorm) proceed without the user's answer. Undocumented var (github.com/anthropics/claude-code/issues/73125); versions without AFK ignore it harmlessly. If your Claude Code exposes a question-timeout toggle in /config, keep it OFF.",
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647"
  },

  "defaultMode": "default",
  "enableAllProjectMcpServers": false,
  "cleanupPeriodDays": 30,

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/file-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
