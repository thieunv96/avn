{
  "$comment": "Asilla company baseline — .claude/settings.json (project-level, shipped as-is by install.sh). Rule syntax: Bash uses exact or prefix match with ':*' (NOT regex). Read/Edit use gitignore-style paths. Precedence: deny > ask > allow. Hook paths use ${CLAUDE_PROJECT_DIR} so every repo (including this one) is guarded. Dotenv policy lives in hooks/file-guard.sh (blocks all .env* except the placeholder templates .env.example/sample/template/dist — deny globs cannot express that exception); the bare .env deny rules here are defense-in-depth. Verify rules after install with /permissions inside Claude Code.",

  "permissions": {

    "deny": [
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(npm install -g:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",

      "Read(./.env)",
      "Read(**/.env)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/credentials.json)",
      "Read(**/secrets/**)",
      "Read(**/kubeconfig)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",

      "Edit(**/.env)",
      "Edit(**/secrets/**)",
      "Edit(**/.github/**)",
      "Edit(**/.mcp.json)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/**)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(npx playwright install:*)",
      "Bash(npm install:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)",
      "Bash(pip install:*)",
      "Bash(uv add:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(kubectl:*)",
      "Bash(helm:*)",
      "Bash(terraform:*)",
      "Bash(ansible:*)",
      "Bash(ansible-playbook:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(az:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Bash(psql:*)",
      "Bash(mysql:*)",
      "Bash(redis-cli:*)",
      "Bash(systemctl:*)"
    ],

    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright screenshot:*)",
      "Bash(npx playwright --version)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(ruff:*)",
      "Bash(go test:*)",
      "Bash(go build:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(python --version)"
    ]
  },

  "$comment-env": "CLAUDE_AFK_TIMEOUT_MS disables the 60s AskUserQuestion auto-advance ('AFK mode') introduced unannounced in Claude Code v2.1.198, which made interview flows (/brainstorm) proceed without the user's answer. Undocumented var (github.com/anthropics/claude-code/issues/73125); versions without AFK ignore it harmlessly. If your Claude Code exposes a question-timeout toggle in /config, keep it OFF.",
  "env": {
    "CLAUDE_AFK_TIMEOUT_MS": "2147483647"
  },

  "defaultMode": "default",
  "enableAllProjectMcpServers": false,
  "cleanupPeriodDays": 30,

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Read|Edit|MultiEdit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/file-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/verify-gate.sh",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
